@page "/Assignment2/Documents"
@model DocumentChatbot.Web.Pages.Assignment2.Documents.IndexModel
@{
    ViewData["Title"] = "Tài liệu";
}

<section class="page-heading">
    <div>
        <p class="eyebrow">@Model.Course.Code · @Model.Course.Name</p>
        <h1>Tài liệu PRN222</h1>
    </div>
    <a class="btn" asp-page="/Assignment2/Documents/Upload">Upload tài liệu</a>
</section>

<section class="realtime-monitor"
         data-document-realtime
         data-course-id="@Model.Course.CourseId">
    <header class="realtime-monitor-header">
        <div>
            <span class="realtime-monitor-kicker">SignalR · course:@Model.Course.CourseId</span>
            <strong>Document indexing live monitor</strong>
        </div>
        <span class="realtime-connection" data-document-connection>
            <i aria-hidden="true"></i>
            Đang kết nối
        </span>
    </header>
    <div class="realtime-progress" data-document-progress data-state="idle" aria-live="polite">
        <div class="realtime-progress-meta">
            <div>
                <strong data-document-stage>Sẵn sàng</strong>
                <span data-document-title>Chưa có tài liệu đang xử lý</span>
            </div>
            <output data-document-percent>0%</output>
        </div>
        <div class="realtime-progress-track"
             data-document-progressbar
             role="progressbar"
             aria-label="Tiến độ xử lý tài liệu"
             aria-valuemin="0"
             aria-valuemax="100"
             aria-valuenow="0">
            <span data-document-progress-fill></span>
        </div>
        <p data-document-message>Upload tài liệu để theo dõi tiến trình trích xuất, chunking và indexing.</p>
    </div>
</section>

<div data-document-content>
    @if (!Model.Documents.Any())
    {
        <div class="empty-state">
            <h2>Chưa có tài liệu</h2>
            <p>Upload tài liệu đầu tiên để hệ thống có dữ liệu phục vụ hỏi đáp.</p>
            <a class="btn" asp-page="/Assignment2/Documents/Upload">Upload tài liệu</a>
        </div>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>Tiêu đề</th><th>Chương</th><th>Tệp</th><th>Trạng thái</th><th>Số chunk</th><th>Người upload</th><th>Ngày upload</th><th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var document in Model.Documents)
            {
                <tr>
                    <td><a asp-page="/Assignment2/Documents/Details" asp-route-id="@document.Id">@document.Title</a></td>
                    <td>@(document.Chapter ?? "-")</td>
                    <td>@document.OriginalFileName</td>
                    <td><span class="status-badge status-@document.Status">@document.Status</span></td>
                    <td>@document.ChunkCount</td>
                    <td>@document.UploadedByName</td>
                    <td>@document.UploadedAtUtc.ToLocalTime().ToString("g")</td>
                    <td>
                        <div class="document-actions">
                            @if (document.Status == DocumentStatus.Indexed)
                            {
                                <a class="btn btn-secondary btn-small"
                                   asp-page="/Assignment2/Documents/Chunks"
                                   asp-route-id="@document.Id">Xem chunks</a>
                            }
                            <a class="btn btn-secondary btn-small"
                               asp-page="/Assignment2/Documents/Details"
                               asp-route-id="@document.Id">Xem</a>
                            <form method="post" asp-page-handler="Delete" asp-route-id="@document.Id" onsubmit="return confirm('Xóa tài liệu này?');" class="inline-form">
                                <button class="btn btn-danger btn-small" type="submit">Xóa</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>

@section Scripts {
    <script src="~/lib/signalr/signalr.min.js"></script>
    <script src="~/js/documents-realtime.js" asp-append-version="true"></script>
}
