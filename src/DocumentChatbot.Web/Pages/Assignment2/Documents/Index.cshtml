@page "/Assignment2/Documents"
@model DocumentChatbot.Web.Pages.Assignment2.Documents.IndexModel
@{
    ViewData["Title"] = "Tài liệu";
}

<section class="page-heading">
    <div>
        <p class="eyebrow">Razor Pages presentation</p>
        <h1>Tài liệu PRN222</h1>
    </div>
    <a class="btn" asp-page="/Assignment2/Documents/Upload">Upload tài liệu</a>
</section>

@if (!Model.Documents.Any())
{
    <div class="empty-state">
        <h2>Chưa có tài liệu</h2>
        <p>Upload tài liệu đầu tiên để hệ thống có dữ liệu phục vụ hỏi đáp.</p>
        <a class="btn" asp-page="/Assignment2/Documents/Upload">Upload tài liệu</a>
    </div>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Tiêu đề</th><th>Chương</th><th>Tệp</th><th>Trạng thái</th><th>Số chunk</th><th>Ngày upload</th><th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var document in Model.Documents)
        {
            <tr>
                <td><a asp-page="/Assignment2/Documents/Details" asp-route-id="@document.Id">@document.Title</a></td>
                <td>@(document.Chapter ?? "-")</td>
                <td>@document.OriginalFileName</td>
                <td><span class="status-badge status-@document.Status">@document.Status</span></td>
                <td>@document.ChunkCount</td>
                <td>@document.UploadedAtUtc.ToLocalTime().ToString("g")</td>
                <td>
                    <form method="post" asp-page-handler="Delete" asp-route-id="@document.Id" onsubmit="return confirm('Xóa tài liệu này?');" class="inline-form">
                        <button class="btn btn-danger btn-small" type="submit">Xóa</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
