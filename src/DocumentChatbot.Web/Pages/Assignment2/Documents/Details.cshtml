@page "/Assignment2/Documents/{id:guid}"
@model DocumentChatbot.Web.Pages.Assignment2.Documents.DetailsModel
@{
    ViewData["Title"] = Model.Document.Title;
    var initialProgress = Model.Document.Status == DocumentStatus.Processing ? 10 : 100;
    var initialState = Model.Document.Status switch
    {
        DocumentStatus.Indexed => "indexed",
        DocumentStatus.Failed => "failed",
        _ => "processing"
    };
    var initialStage = Model.Document.Status switch
    {
        DocumentStatus.Indexed => "Hoàn tất",
        DocumentStatus.Failed => "Thất bại",
        _ => "Đang xử lý"
    };
    var initialMessage = Model.Document.Status switch
    {
        DocumentStatus.Indexed => $"{Model.Document.ChunkCount} chunks đã sẵn sàng để truy xuất.",
        DocumentStatus.Failed => Model.Document.ProcessingError ?? "Không thể lập chỉ mục tài liệu.",
        _ => "Tài liệu đang chờ tiến trình xử lý tiếp theo."
    };
}

<p><a asp-page="/Assignment2/Documents/Index">← Quay lại danh sách</a></p>

<section class="realtime-monitor"
         data-document-realtime
         data-course-id="@Model.Document.CourseId"
         data-document-id="@Model.Document.Id">
    <header class="realtime-monitor-header">
        <div>
            <span class="realtime-monitor-kicker">SignalR · BackgroundService</span>
            <strong>Tiến trình lập chỉ mục realtime</strong>
        </div>
        <span class="realtime-connection" data-document-connection>
            <i aria-hidden="true"></i>
            Đang kết nối
        </span>
    </header>
    <div class="realtime-progress" data-document-progress data-state="@initialState" aria-live="polite">
        <div class="realtime-progress-meta">
            <div>
                <strong data-document-stage>@initialStage</strong>
                <span data-document-title>@Model.Document.Title</span>
            </div>
            <output data-document-percent>@initialProgress%</output>
        </div>
        <div class="realtime-progress-track"
             data-document-progressbar
             role="progressbar"
             aria-label="Tiến độ xử lý tài liệu"
             aria-valuemin="0"
             aria-valuemax="100"
             aria-valuenow="@initialProgress">
            <span data-document-progress-fill style="transform: scaleX(@(initialProgress / 100d));"></span>
        </div>
        <p data-document-message>@initialMessage</p>
    </div>
</section>

<div data-document-content>
<h1>@Model.Document.Title</h1>
<p><span class="status-badge status-@Model.Document.Status">@Model.Document.Status</span></p>

@if (!string.IsNullOrWhiteSpace(Model.Document.ProcessingError))
{
    <div class="alert alert-danger">@Model.Document.ProcessingError</div>
}

<table>
    <tbody>
        <tr><th>Tệp</th><td>@Model.Document.OriginalFileName (@Model.Document.FileType)</td></tr>
        <tr><th>Chương</th><td>@(Model.Document.Chapter ?? "-")</td></tr>
        <tr><th>Dung lượng</th><td>@(Model.Document.FileSizeBytes / 1024) KB</td></tr>
        <tr><th>Số chunk</th><td>@Model.Document.ChunkCount</td></tr>
        <tr><th>Người upload</th><td>@Model.Document.UploadedByName</td></tr>
        <tr><th>Thời gian</th><td>@Model.Document.UploadedAtUtc.ToLocalTime().ToString("g")</td></tr>
    </tbody>
</table>

<div class="details-actions">
    <a class="btn btn-secondary" asp-page="/Assignment2/Documents/Index">Về danh sách</a>
    @if (Model.Document.Status == DocumentStatus.Indexed)
    {
        <a class="btn"
           asp-page="/Assignment2/Documents/Chunks"
           asp-route-id="@Model.Document.Id">Xem @Model.Document.ChunkCount chunks</a>
    }
    <form method="post" asp-page-handler="Delete" asp-route-id="@Model.Document.Id" onsubmit="return confirm('Xóa tài liệu này?');" class="inline-form">
        <button class="btn btn-danger" type="submit">Xóa tài liệu</button>
    </form>
</div>
</div>

@section Scripts {
    <script src="~/lib/signalr/signalr.min.js"></script>
    <script src="~/js/documents-realtime.js" asp-append-version="true"></script>
}
