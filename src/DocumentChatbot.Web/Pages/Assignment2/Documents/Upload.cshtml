@page "/Assignment2/Documents/Upload"
@model DocumentChatbot.Web.Pages.Assignment2.Documents.UploadModel
@{
    ViewData["Title"] = "Upload tài liệu";
}

<p><a asp-page="/Assignment2/Documents/Index">← Quay lại danh sách</a></p>
<section class="page-heading compact">
    <div>
        <h1>Upload tài liệu</h1>
        <p>Thêm PDF, DOCX hoặc PPTX để hệ thống trích xuất, chia đoạn và lập chỉ mục cho @Model.Course.Code.</p>
    </div>
</section>

<form method="post" enctype="multipart/form-data" class="form-panel">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <div class="field">
        <label asp-for="Input.Title"></label>
        <input asp-for="Input.Title" />
        <span asp-validation-for="Input.Title"></span>
    </div>
    <div class="field">
        <label asp-for="Input.Chapter"></label>
        <input asp-for="Input.Chapter" />
        <span asp-validation-for="Input.Chapter"></span>
    </div>
    <div class="field">
        <label asp-for="Input.File"></label>
        <input asp-for="Input.File" type="file" accept=".pdf,.docx,.pptx" />
        <span asp-validation-for="Input.File"></span>
    </div>
    <p class="field-hint">Dung lượng tối đa 25 MB.</p>
    <aside class="upload-process-note">
        <strong>Sau khi upload</strong>
        <ol>
            <li>C# trích xuất nội dung theo trang PDF, slide PPTX hoặc đoạn DOCX.</li>
            <li>Python chia nội dung thành chunks và tạo embedding.</li>
            <li>Chroma lưu chỉ mục để chatbot truy xuất.</li>
        </ol>
    </aside>
    <div class="form-actions">
        <a class="btn btn-secondary" asp-page="/Assignment2/Documents/Index">Hủy</a>
        <button class="btn" type="submit">Upload và lập chỉ mục</button>
    </div>
</form>
