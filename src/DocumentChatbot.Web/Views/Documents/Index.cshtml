@model CourseDocumentsViewModel
@{
    ViewData["Title"] = "Tài liệu";
}

<section class="document-page">
    <header class="document-header">
        <div class="document-header-content">
            <a asp-controller="Courses" asp-action="Index" class="back-link">← Danh sách môn học</a>
            <p class="eyebrow">@Model.Course.Code · @Model.Course.Name</p>
            <h1>Tài liệu môn học</h1>
            <p>Quản lý tài liệu theo chương và theo dõi trạng thái lập chỉ mục.</p>
        </div>
        <a asp-action="Upload" asp-route-courseId="@Model.Course.CourseId" class="btn">+ Upload tài liệu</a>
    </header>

    <div class="document-card">
        <header class="document-card-header">
            <div>
                <strong>Danh sách tài liệu</strong>
                <span>@Model.Documents.Count tài liệu</span>
            </div>
        </header>

        @if (!Model.Documents.Any())
        {
            <div class="empty-state document-empty-state">
                <span class="empty-state-icon" aria-hidden="true">DOC</span>
                <h2>Chưa có tài liệu</h2>
                <p>Upload tài liệu đầu tiên để hệ thống có dữ liệu phục vụ chức năng hỏi đáp.</p>
                <a asp-action="Upload" asp-route-courseId="@Model.Course.CourseId" class="btn">Upload tài liệu đầu tiên</a>
            </div>
        }
        else
        {
            <div class="document-table-wrap">
                <table class="document-table">
                    <thead>
                        <tr>
                            <th>Tài liệu</th>
                            <th>Chương</th>
                            <th>Loại</th>
                            <th>Trạng thái</th>
                            <th>Chunks</th>
                            <th>Người upload</th>
                            <th>Ngày upload</th>
                            <th><span class="sr-only">Thao tác</span></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var document in Model.Documents)
                    {
                        <tr>
                            <td>
                                <a asp-action="Details" asp-route-id="@document.Id" class="document-title">@document.Title</a>
                                <span class="document-subtitle">@document.OriginalFileName</span>
                            </td>
                            <td>@(document.Chapter ?? "—")</td>
                            <td><span class="file-type">@document.FileType</span></td>
                            <td><span class="status-badge status-@document.Status">@document.Status</span></td>
                            <td class="numeric-cell">@document.ChunkCount</td>
                            <td>@document.UploadedByName</td>
                            <td><time datetime="@document.UploadedAtUtc.ToString("O")">@document.UploadedAtUtc.ToLocalTime().ToString("g")</time></td>
                            <td>
                                <div class="document-actions">
                                    @if (document.Status == DocumentStatus.Indexed)
                                    {
                                        <a asp-action="Chunks" asp-route-id="@document.Id" class="btn btn-secondary btn-small">Xem chunks</a>
                                    }
                                    <a asp-action="Details" asp-route-id="@document.Id" class="btn btn-secondary btn-small">Xem</a>
                                    <form method="post" asp-action="Delete" asp-route-id="@document.Id"
                                          onsubmit="return confirm('Xóa tài liệu này?');" class="inline-form">
                                        <button type="submit" class="btn btn-danger btn-small">Xóa</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>
