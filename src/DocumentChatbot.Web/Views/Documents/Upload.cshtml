@model DocumentUploadViewModel
@{
    ViewData["Title"] = "Upload tài liệu";
    var course = (CourseSummary)ViewData["Course"]!;
}

<section class="document-page">
    <div class="upload-container">
        <a asp-action="Index" asp-route-courseId="@Model.CourseId" class="back-link">← Quay lại danh sách tài liệu</a>

        <header class="page-header">
            <p class="eyebrow">Nguồn tri thức @course.Code</p>
            <h1>Upload tài liệu</h1>
            <p>Thêm PDF, DOCX hoặc PPTX để hệ thống trích xuất, chia đoạn và lập chỉ mục.</p>
        </header>

        <form asp-action="Upload" method="post" enctype="multipart/form-data">
            <input asp-for="CourseId" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <article class="upload-card">
                <header class="upload-card-header">
                    <div>
                        <h2>Thông tin tài liệu</h2>
                        <p>Nhập thông tin mô tả trước khi chọn tệp.</p>
                    </div>
                    <span class="step-label">01 / Upload</span>
                </header>

                <div class="upload-card-body">
                    <div class="field">
                        <label asp-for="Title"></label>
                        <input asp-for="Title" type="text" placeholder="Ví dụ: Dependency Injection trong ASP.NET Core" />
                        <span asp-validation-for="Title"></span>
                    </div>

                    <div class="field">
                        <label asp-for="Chapter"></label>
                        <input asp-for="Chapter" type="text" placeholder="Ví dụ: Chapter 3" />
                        <span asp-validation-for="Chapter"></span>
                    </div>

                    <div class="field">
                        <label asp-for="File"></label>
                        <div class="file-upload-box">
                            <span class="file-upload-icon" aria-hidden="true">FILE</span>
                            <div>
                                <strong class="file-upload-title">Chọn tài liệu môn học</strong>
                                <p class="file-upload-description">PDF, DOCX hoặc PPTX · Dung lượng tối đa 25 MB</p>
                            </div>
                            <input asp-for="File" type="file" accept=".pdf,.docx,.pptx" />
                        </div>
                        <span asp-validation-for="File"></span>
                    </div>

                    <aside class="upload-process-note">
                        <strong>Sau khi upload</strong>
                        <ol>
                            <li>C# trích xuất nội dung tệp.</li>
                            <li>Python chia đoạn và tạo embedding.</li>
                            <li>Chroma lưu chỉ mục để chatbot truy xuất.</li>
                        </ol>
                    </aside>

                    <div class="form-actions">
                        <a asp-action="Index" asp-route-courseId="@Model.CourseId" class="btn btn-secondary">Hủy</a>
                        <button type="submit" class="btn">Upload</button>
                    </div>
                </div>
            </article>
        </form>
    </div>
</section>
