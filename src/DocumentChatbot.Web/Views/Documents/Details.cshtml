@model DocumentSummary
@{
    ViewData["Title"] = Model.Title;
    var course = (CourseSummary)ViewData["Course"]!;
}

<section class="document-page">
    <div class="details-container">
        <a asp-action="Index" asp-route-courseId="@Model.CourseId" class="back-link">← Quay lại tài liệu @course.Code</a>

        <header class="details-header">
            <div>
                <p class="eyebrow">Chi tiết tài liệu</p>
                <h1 class="details-title">@Model.Title</h1>
                <p class="details-subtitle">@(Model.Chapter ?? "Chưa phân chương") · @Model.OriginalFileName</p>
            </div>
            <span class="status-badge status-@Model.Status">@Model.Status</span>
        </header>

        @if (!string.IsNullOrWhiteSpace(Model.ProcessingError))
        {
            <div class="alert alert-danger">
                <strong>Lập chỉ mục thất bại.</strong>
                <span>@Model.ProcessingError</span>
            </div>
        }

        <div class="details-stats">
            <article class="stat-card">
                <span class="stat-label">Loại tệp</span>
                <strong class="stat-value">@Model.FileType</strong>
            </article>
            <article class="stat-card">
                <span class="stat-label">Dung lượng</span>
                <strong class="stat-value">@((Model.FileSizeBytes / 1024.0).ToString("N0")) KB</strong>
            </article>
            <article class="stat-card">
                <span class="stat-label">Chunks đã index</span>
                <strong class="stat-value">@Model.ChunkCount</strong>
            </article>
        </div>

        <article class="document-card document-details-card">
            <header class="document-card-header">
                <strong>Thông tin tài liệu</strong>
            </header>
            <dl class="details-list">
                <div><dt>Tên tệp gốc</dt><dd>@Model.OriginalFileName</dd></div>
                <div><dt>Chương</dt><dd>@(Model.Chapter ?? "—")</dd></div>
                <div><dt>Người upload</dt><dd>@Model.UploadedByName</dd></div>
                <div><dt>Thời gian upload</dt><dd>@Model.UploadedAtUtc.ToLocalTime().ToString("g")</dd></div>
                <div><dt>Trạng thái xử lý</dt><dd><span class="status-badge status-@Model.Status">@Model.Status</span></dd></div>
            </dl>
        </article>

        <div class="details-actions">
            <a asp-action="Index" asp-route-courseId="@Model.CourseId" class="btn btn-secondary">Về danh sách</a>
            @if (Model.Status == DocumentStatus.Indexed)
            {
                <a asp-action="Chunks" asp-route-id="@Model.Id" class="btn">Xem @Model.ChunkCount chunks</a>
            }
            <form method="post" asp-action="Delete" asp-route-id="@Model.Id"
                  onsubmit="return confirm('Xóa tài liệu này?');" class="inline-form">
                <button type="submit" class="btn btn-danger">Xóa tài liệu</button>
            </form>
        </div>
    </div>
</section>
