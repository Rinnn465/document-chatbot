<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - PRN222 Assistant</title>
    <link rel="stylesheet" href="~/site.css" asp-append-version="true" />
</head>
<body class="@ViewData["BodyClass"]">
    <header class="site-header">
        <div class="site-header-inner">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <span class="brand-badge" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                        <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                        <line x1="12" y1="22.08" x2="12" y2="12"></line>
                    </svg>
                </span>
                <span class="brand-text">
                    <strong>PRN222</strong>
                    <small>Doc Assistant</small>
                </span>
            </a>
            @if (User.Identity?.IsAuthenticated == true && User.IsInRole("SubjectLeader"))
            {
                <nav class="assignment-nav" aria-label="Assignment 2 demo">
                    <a asp-page="/Assignment2/Documents/Index" class="nav-pill">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                        <span>Assignment 2 · Razor Pages</span>
                    </a>
                </nav>
            }
            else if (User.Identity?.IsAuthenticated == true && User.IsInRole("Student"))
            {
                <nav class="assignment-nav" aria-label="Assignment 2 demo">
                    <a asp-page="/Assignment2/Chat/Index" class="nav-pill">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z" />
                        </svg>
                        <span>Assignment 2 · Razor Pages</span>
                    </a>
                </nav>
            }
            <div class="account-nav">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="user-chip">
                        <span class="user-chip-avatar">@((User.Identity.Name ?? "U")[0].ToString().ToUpperInvariant())</span>
                        <span class="user-chip-name">@User.Identity.Name</span>
                    </div>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button class="nav-button-logout" type="submit" title="Đăng xuất khỏi hệ thống">
                            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                <polyline points="16 17 21 12 16 7"></polyline>
                                <line x1="21" y1="12" x2="9" y2="12"></line>
                            </svg>
                            <span>Đăng xuất</span>
                        </button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="nav-button-login">Đăng nhập</a>
                }
            </div>
        </div>
    </header>

    <main class="container">
        @if (TempData["Success"] is string success)
        {
            <div class="alert alert-success">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                <span>@success</span>
            </div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                <span>@error</span>
            </div>
        }
        @RenderBody()
    </main>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
