@model LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
    ViewData["BodyClass"] = "auth-page";
}

<section class="auth-shell" aria-labelledby="login-title">
    <div class="auth-panel">
        <div class="auth-mark" aria-hidden="true">P2</div>
        <header class="auth-heading">
            <p>PRN222 Document Chatbot</p>
            <h1 id="login-title">Đăng nhập</h1>
        </header>

        <form asp-action="Login" method="post" class="auth-form">
            <input asp-for="ReturnUrl" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="field">
                <label asp-for="Email"></label>
                <input asp-for="Email" autocomplete="username" placeholder="name@example.com" autofocus />
                <span asp-validation-for="Email"></span>
            </div>

            <div class="field">
                <label asp-for="Password"></label>
                <input asp-for="Password" autocomplete="current-password" placeholder="Nhập mật khẩu" />
                <span asp-validation-for="Password"></span>
            </div>

            <button class="auth-submit" type="submit">Đăng nhập</button>
        </form>
    </div>
</section>
